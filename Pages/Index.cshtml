@page
@model IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Grading Sheet";
}
<style>
    #compact-form {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 8px;
    }

        #compact-form table {
            width: 100%;
            table-layout: fixed;
        }

        #compact-form td,
        #compact-form th {
            padding: 3px 6px;
            line-height: 1.2;
            vertical-align: middle;
            white-space: nowrap;
        }

        #compact-form .form-control,
        #compact-form .form-control-sm {
            height: 24px;
            padding: 1px 6px;
            /* font-size: 12px; */
            line-height: 1.2;
            width: 100%;
        }

        #compact-form textarea {
            height: 40px;
            resize: none;
        }

    .input-xs {
        max-width: 60px;
    }

    .input-sm {
        max-width: 80px;
    }

    .input-md {
        max-width: 110px;
    }

    .input-lg {
        max-width: 150px;
    }

    #compact-form table input,
    #compact-form table select,
    #compact-form table textarea {
        border: none;
        outline: none;
        background: transparent;
    }

    .section-title {
        font-weight: bold;
        background-color: #f2f2f2;
        text-align: left;
        padding: 4px 6px;
    }

    #compact-form .btn-sm {
        padding: 2px 8px;
        font-size: 12px;
    }

    button:disabled,
    .btn:disabled {
        cursor: not-allowed !important;
        opacity: 0.55;
        pointer-events: auto;
    }

    @@media (max-width: 768px) {
        #compact-form {
            max-width: 100%;
        }

            #compact-form td,
            #compact-form th {
                padding: 2px 4px;
            }

        .input-xs,
        .input-sm,
        .input-md,
        .input-lg {
            max-width: 100%;
        }
    }

    .sheet-container {
        width: 85%;
        margin: 0 auto;
    }

    .header-table td {
        padding: 12px 12px;
    }

    .header-title {
        font-size: 22px;
        font-weight: 700;
    }

    .header-subtitle {
        font-size: 15px;
        font-weight: 600;
    }

</style>
<div class="sheet-container">
    <div id="compact-form">
        <div style="text-align:center; padding:14px 12px;">
            <h1 class="text-center">@Configuration["AppSettings:ApplicationTitle"]</h1>
            <h3 class="text-center">Grading Sheet</h3>
        </div>
        
        <form method="post">
            <table style="width:30%">
                <tr>
                    <td width="23%">Sl No:</td>

                    <td style="font-weight:700;
                        font-size:22px;
                        color:red;
                        text-align:center"
                        id="sheetNoDisplay">
                        @Model.SheetNo
                    </td>
                </tr>

                <tr>
                    <td>Date:</td>
                    <td>
                        <input asp-for="Batch.BatchDate"
                               type="date"
                               class="form-control"
                               onchange="onDateChanged(this.value)" />
                    </td>
                </tr>
            </table>

            <input type="hidden"
                   asp-for="Batch.SheetNo"
                   id="SheetNoHidden" />

            <input type="hidden" asp-for="Batch.BatchId" />
            <table class="table table-bordered mt-1" width="50%">
                <tr style="background-color:lightskyblue">
                    <td colspan="4" class="section-title">Batch Details</td>
                </tr>
                <tr>
                    <td>From</td>
                    <td><input asp-for="Batch.From" class="form-control" oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '')" required /></td>
                
                    <td>Average Count</td>
                    <td><input asp-for="Batch.AvgCount" class="form-control" oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '')" required /></td>
                </tr>
                <tr>
                    <td>Vehicle</td>
                    <td><input asp-for="Batch.VehicleNo" class="form-control" oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '')" required /></td>
                    <td>B2</td>
                    <td><input asp-for="Batch.B2" class="form-control" required /></td>
                </tr>
                <tr>
                    <td>Center</td>
                    <td><input asp-for="Batch.Center" class="form-control" oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '')" required /></td>

                
                    <td>B4</td>
                    <td><input asp-for="Batch.B4" class="form-control" /></td>
                </tr>

                <tr>
                    <td>HL / HOT</td>
                    <td><input asp-for="Batch.HLHot" class="form-control" required /></td>
                    <td>Shrimp / Sec</td>
                    <td><input asp-for="Batch.ShrimpPerSec" class="form-control" required /></td>
                </tr>
                <tr>
                    <td>HL Count</td>
                    <td><input asp-for="Batch.HLCount" class="form-control" required /></td>
                    <td>G2</td>
                    <td><input asp-for="Batch.G2" class="form-control" required /></td>
                </tr>
                <tr>
                    <td>Sample Count</td>
                    <td><input asp-for="Batch.SamCount" class="form-control" required /></td>
                    <td>Remarks</td>
                    <td>
                        <textarea asp-for="Batch.Remarks"
                                  class="form-control"></textarea>
                    </td>
                </tr>
          </table>
            <div class="text-end mt-1">
                <button class=" btn btn-success" asp-page-handler="SaveBatch">Save</button>
            </div>
        </form>

        <div id="gradingSection">
            <form method="post">
                <input type="hidden" asp-for="Batch.BatchId" />
                <table class="table table-bordered mt-3">
                    <tr style="background-color:lightskyblue">
                        <td colspan="7" class="section-title">Grading Details</td>
                    </tr>
                    <tr style="background-color:lightskyblue">
                        <th>BIN</th>
                        <th>FROM</th>
                        <th>TO</th>
                        <th>MANUAL</th>
                        <th>SCREEN</th>
                        <th>B/S</th>
                        <th>FILL</th>
                    </tr>
                    @for (int i = 0; i < Model.Screenings.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Screenings[i].BIN
                                <input type="hidden"
                                       asp-for="Screenings[i].BIN" />
                            </td>
                            <td><input asp-for="Screenings[i].From" class="form-control " onclick="this.select()" /></td>
                            <td><input asp-for="Screenings[i].To" class="form-control " onclick="this.select()" /></td>
                            <td><input asp-for="Screenings[i].Manual" class="form-control " onclick="this.select()" inputmode="decimal" /></td>
                            <td><input asp-for="Screenings[i].Screen" class="form-control " onclick="this.select()" /></td>
                            <td><input asp-for="Screenings[i].BS" class="form-control " onclick="this.select()" /></td>
                            <td>
                                @if (i > 0)
                                {
                                    <button type="button"
                                            class="btn btn-dark btn-sm px-3"
                                            onclick="fillRow(@i)">
                                        Fill
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </table>
                <div class="text-end mt-3">
                    <button class="btn btn-success"
                            asp-page-handler="SaveAllGrading"
                            disabled="@(Model.Batch.BatchId <= 0)">
                        Save Grading
                    </button>
                </div>
            </form>
        </div>

        <div id="summarySection" class="mt-4">
            <form method="post">
                <input type="hidden" asp-for="Batch.BatchId" />
                <table class="table table-bordered">
                    <colgroup>
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                        <col width="20%" />
                    </colgroup>
                    <tr style="background-color:lightskyblue;">
                        <td colspan="7" class="section-title">Summary</td>
                    </tr>
                    <tr style="background-color:lightskyblue;">
                        <th>GRADE</th>
                        <th>VAR<br />IETY</th>
                        <th>COU<br />NT</th>
                        <th>B /S</th>
                        <th>KGS</th>
                        <th>%</th>
                        <th>PO No.</th>
                    </tr>
                    <tbody>
                        @foreach (var row in Model.SummaryRows)
                        {
                            <tr>
                                <td>
                                    <select class="form-control" name="GradeId[@row.Manual]" required>
                                        <option value="">-- Select --</option>
                                        @foreach (var g in Model.Grades)
                                        {
                                            <option value="@g.Id"
                                                    selected="@(row.GradeId == g.Id)">
                                                @g.Name
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-control" name="ProductVarietyId[@row.Manual]" required>
                                        <option value="">-- Select --</option>
                                        @foreach (var v in Model.ProductVarieties)
                                        {
                                            <option value="@v.Id"
                                                    selected="@(row.ProductVarietyId == v.Id)">
                                                @v.Name
                                            </option>
                                        }
                                    </select>

                                </td>
                                <td>
                                    <input class="form-control"
                                           value="@row.Manual"
                                           readonly />
                                </td>
                                <td>
                                    <input class="form-control"
                                           value="@row.TotalBS"
                                           readonly />
                                </td>
                                <td>
                                    <input class="form-control kgs-input"
                                           name="Kgs[@row.Manual.ToString("0.##")]"
                                           value="@row.Kgs"
                                           oninput="calculatePercentage()" required />

                                </td>
                                <td>
                                    <input class="form-control percentage"
                                           name="Percentage[@row.Manual]"
                                           value="@row.Percentage"
                                           readonly />

                                </td>
                                <td>
                                    <input class="form-control"
                                           name="PONumber[@row.Manual]"
                                           value="@row.PONumber" oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '')" required />

                                </td>
                            </tr>
                        }
                    </tbody>
                    <tr style="font-weight:bold; background:#f2f2f2;">
                        <td colspan="4" class="text-end">TOTAL</td>
                        <td>
                            <input class="form-control text-end"
                                   value="@Model.TotalKgs.ToString("0.00")"
                                   readonly />
                        </td>
                        <td colspan="2"></td>
                    </tr>
                </table>
                <div class="text-end mt-3">
                    <button type="submit"
                            class="btn btn-success"
                            asp-page-handler="SaveSummary" disabled="@(!Model.IsGradingSaved)">
                        Save Summary
                    </button>
                </div>
            </form>
        </div>

        <form method="post" class="text-center mt-1">
            <input type="hidden" asp-for="Batch.BatchId" />
            <button type="button"
                    class="btn btn-danger btn-lg"
                    data-bs-toggle="modal"
                    data-bs-target="#endBatchModal"
                    disabled="@(!Model.IsSummarySaved)">
                END
            </button>
        </form>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="modal fade" id="messageModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header bg-@TempData["MessageType"] text-white">
                    <h6 class="modal-title">
                        @TempData["MessageTitle"]
                    </h6>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body text-center">
                    @TempData["Message"]
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">
                        OK
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<div class="modal fade" id="endBatchModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title">
                    Confirm End Batch
                </h6>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                Are you sure you want to end this batch?
                <br />
                <strong>This will close the batch and lock the sheet.</strong>
            </div>

            <div class="modal-footer justify-content-center">
                <form method="post" asp-page-handler="EndBatch">
                    <input type="hidden" asp-for="Batch.BatchId" />
                    <button type="submit" class="btn btn-danger btn-sm">
                        Yes, End Batch
                    </button>
                </form>

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
            </div>

        </div>
    </div>
</div>

<script>

       document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("messageModal");
        if (modal) {
            new bootstrap.Modal(modal).show();
        }
    });
    function loadScreening(id, bin, from, to, manual, screen, bs) {
        document.getElementById("editScreeningId").value = id;
        document.getElementById("editBIN").value = bin;
        document.getElementById("editFrom").value = from;
        document.getElementById("editTo").value = to;
        document.getElementById("editManual").value = manual;
        document.getElementById("editScreen").value = screen;
        document.getElementById("editBS").value = bs;
    }

    function loadSummary(count, gradeId, varietyId, kgs, percentage, poNo) {
        document.getElementById("editSummaryCountHidden").value = count;
        document.getElementById("editSummaryCountDisplay").value = count;
        document.getElementById("editSummaryKgs").value = kgs ?? "";
        document.getElementById("editSummaryPercentage").value = percentage ?? "";
        document.getElementById("editSummaryPONumber").value = poNo ?? "";
        document.getElementById("editSummaryGrade").value = gradeId ?? "";
        document.getElementById("editSummaryVariety").value = varietyId ?? "";
    }

    function calculatePercentage() {
        let totalKgs = 0;
        const kgsInputs = document.querySelectorAll(".kgs-input");
        const percentageInputs = document.querySelectorAll(".percentage");
        kgsInputs.forEach(input => {
            const val = parseFloat(input.value);
            if (!isNaN(val)) {
                totalKgs += val;
            }
        });
        const totalKgsInput = document.getElementById("totalKgs");
        if (totalKgsInput) {
            totalKgsInput.value = totalKgs > 0 ? totalKgs.toFixed(2) : "";
        }
        kgsInputs.forEach((input, index) => {
            const kgs = parseFloat(input.value);
            const percentageInput = percentageInputs[index];

            if (!isNaN(kgs) && totalKgs > 0) {
                percentageInput.value =
                    ((kgs / totalKgs) * 100).toFixed(2);
            } else {
                percentageInput.value = "";
            }
        });
    }

     function fillRow(index) {
        const prev = index - 1;

        const fields = ["From", "To", "Manual", "Screen", "BS"];

        fields.forEach(f => {
            const prevInput =
                document.querySelector(`[name="Screenings[${prev}].${f}"]`);
            const currInput =
                document.querySelector(`[name="Screenings[${index}].${f}"]`);

            if (prevInput && currInput) {
                currInput.value = prevInput.value;
            }
        });
    }
        document.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            const el = e.target;

            if (el.tagName !== "INPUT" && el.tagName !== "TEXTAREA" && el.tagName !== "SELECT")
                return;

            e.preventDefault();

            const form = el.closest("form");
            if (!form) return;

            const focusable = Array.from(
                form.querySelectorAll("input, textarea, select, button")
            ).filter(x =>
                !x.disabled &&
                !x.readOnly &&
                x.type !== "hidden" &&
                x.offsetParent !== null
            );

            const index = focusable.indexOf(el);
            if (index > -1 && index + 1 < focusable.length) {
                focusable[index + 1].focus();
                focusable[index + 1].select?.();
            }
        }
    });
        document.addEventListener("keydown", function (e) {
        const keys = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"];
        if (!keys.includes(e.key)) return;

        const el = e.target;
        if (!["INPUT", "SELECT", "TEXTAREA"].includes(el.tagName)) return;

        const td = el.closest("td");
        const tr = el.closest("tr");
        const table = el.closest("table");
        if (!td || !tr || !table) return;

        e.preventDefault();

        const colIndex = td.cellIndex;
        const rowIndex = tr.rowIndex;

        let target;

        switch (e.key) {
            case "ArrowRight":
                target = tr.cells[colIndex + 1];
                break;

            case "ArrowLeft":
                target = tr.cells[colIndex - 1];
                break;

            case "ArrowDown":
                target = table.rows[rowIndex + 1]?.cells[colIndex];
                break;

            case "ArrowUp":
                target = table.rows[rowIndex - 1]?.cells[colIndex];
                break;
        }

        if (!target) return;

        const input = target.querySelector("input, select, textarea");
        if (input && !input.disabled && !input.readOnly) {
            input.focus();
            input.select?.();
        }
    });

       function onDateChanged(date) {
        if (!date) return;

        fetch(`?handler=SheetNoForDate&date=${date}`)
            .then(r => r.json())
            .then(no => {
                document.getElementById("sheetNoDisplay").innerText = no;
            });
    }
        document.addEventListener("DOMContentLoaded", function () {

        const dateInput = document.getElementById("Batch_BatchDate");
        if (!dateInput) return;

        dateInput.addEventListener("change", function () {
            const selectedDate = this.value;
            if (!selectedDate) return;

            fetch(`?handler=SheetNoForDate&date=${selectedDate}`)
                .then(res => res.json())
                .then(no => {

                    document.getElementById("sheetNoDisplay").innerText = no;

                    document.getElementById("SheetNoHidden").value = no;
                });
        });

    });
</script>